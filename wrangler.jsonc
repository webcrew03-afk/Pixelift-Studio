{
  // Pixelift Studio — static site + Worker for secure kit downloads
  "name": "pixelift-studio",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  // Keep variables added in the Cloudflare dashboard when deploying from GitHub
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/dashboard", "/dashboard/", "/buy", "/buy/", "/insta", "/insta/"]
  }
}
